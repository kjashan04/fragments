# POST with Content-Type that includes charset
POST http://localhost:8080/v1/fragments
Content-Type: text/plain; charset=utf-8
[BasicAuth]
user1@email.com:password1
#Authorization: Bearer eyJraWQiOiIxMDdKRVRLdEIyQWlLQzlOM3VueHBMRWF0R3QrSVR0aEZMb0RZVVZaNlNjPSIsImFsZyI6IlJTMjU2In0..iDnetVbA0b6SEyB4fEeIeScAzG0ltVqKNxcRjnTUQabggbwFMZ3fH9endiiRFFjqXqvLwQiO0g-qDxw1nremqjXNKjUUoRF-oLu0lRocH9PHNwHw7AcZaO6gg8SakHCf-5yaC8EBMNVIcGjBj5gSGDsHy1EWfB-9AGyGt_S2IL4EBU_DiHkNMZEopnwscCVWmAsn_GC8xNRpxZ8AiJJkKgapNKsIRy0qqRNfz0MQ1tg8gy6fAFbHDsAwieO_FhCf40lPc35ijWtUpFyHbk3TmcbrJ3Edzu_yo1De-o9lef9_z6HbWrHuwOg9RLHa8xyYIq66qYWNtqzPWrl5XFUj7A

`This is a fragment with charset!`

HTTP/1.1 201
[Asserts]
header "Location" matches "^http:\/\/localhost:8080\/v1\/fragments\/[A-Za-z0-9_-]+$"
jsonpath "$.status" == "ok"
jsonpath "$.fragment.type" == "text/plain; charset=utf-8"
jsonpath "$.fragment.size" == 32

[Captures]
fragmentUrl: header "Location"

